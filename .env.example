# =============================================================================
# TimeFlow sync server — environment variables (Vercel / serverless)
# Copy to `.env` for local dev. In production set these in Vercel → Settings → Environment Variables.
# =============================================================================

# --- Database (Neon via Vercel) ---------------------------------------------
# Pooled connection (PgBouncer) used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct (unpooled) connection used by `prisma migrate` (set DIRECT_URL = Neon's *-UNPOOLED url).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Auth / sync ------------------------------------------------------------
# "token" | "session". In production with token mode SYNC_API_TOKENS is REQUIRED.
SYNC_AUTH_MODE="token"
# Comma-separated userId=token pairs, e.g. "user-1=abc123,user-2=def456"
SYNC_API_TOKENS=""
# Optional HMAC secret for derived API tokens.
SYNC_API_TOKEN_SECRET=""
# Admin dashboard / admin API token.
ADMIN_API_TOKEN=""
# CORS allow-list (comma-separated) or "*".
SYNC_ALLOWED_ORIGINS="*"
# Must be false in production.
SYNC_ALLOW_INSECURE_DEV_USERID_FALLBACK="false"

# --- Cron (Vercel Cron) -----------------------------------------------------
# Shared secret; the cron route rejects requests without it.
CRON_SECRET=""

# --- Encryption -------------------------------------------------------------
# "none" | "server" | "e2e"
ENCRYPTION_MODE="none"
# >= 32 chars. REQUIRED in production when an SFTP storage backend is configured.
SYNC_ENCRYPTION_KEY=""

# --- Logging ----------------------------------------------------------------
# "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"

# --- Limits (optional; sensible defaults in src/lib/config/env.ts) ----------
# SYNC_MAX_PAYLOAD_BYTES="20971520"
# SYNC_RATE_LIMIT_WINDOW_MS="60000"
# SYNC_RATE_LIMIT_MAX_REQUESTS="120"
# SYNC_MAX_ARRAY_ITEMS="100000"
# SYNC_MAX_OBJECT_KEYS="10000"
# SYNC_MAX_JSON_DEPTH="32"

# --- Default SFTP storage backend (optional) --------------------------------
# SFTP_HOST=""
# SFTP_PORT="22"
# SFTP_USER=""
# SFTP_PASSWORD=""
# SFTP_BASE_PATH="/timeflow-sync/"
# SFTP_MAX_FILE_SIZE_MB="100"

# --- Feedback attachments (optional, Vercel Blob) ---------------------------
# Auto-injected by Vercel when a Blob store is connected.
# BLOB_READ_WRITE_TOKEN=""

# NOTE: SYNC_DATA_DIR is no longer used — all state lives in Postgres (and Blob).
