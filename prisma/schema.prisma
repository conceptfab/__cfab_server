generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for serverless runtime.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection for migrations / introspection.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  publicUserId String?       @unique @map("public_user_id")
  email        String?       @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  devices       Device[]
  syncHead      SyncHead?
  syncSnapshots SyncSnapshot[]
  syncEvents    SyncEvent[]

  @@map("users")
}

model Device {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  deviceId           String    @map("device_id")
  displayName        String?   @map("display_name")
  lastSeenAt         DateTime? @map("last_seen_at")
  lastClientRevision Int?      @map("last_client_revision")
  lastClientHash     String?   @map("last_client_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSnapshots SyncSnapshot[]

  @@unique([userId, deviceId], map: "devices_user_id_device_id_key")
  @@index([userId], map: "devices_user_id_idx")
  @@map("devices")
}

model SyncHead {
  userId                String   @id @map("user_id")
  latestRevision        Int      @default(0) @map("latest_revision")
  latestSnapshotId      String?  @map("latest_snapshot_id")
  latestPayloadSha256   String?  @map("latest_payload_sha256")
  latestDeviceId        String?  @map("latest_device_id")
  latestTableHashesJson Json?    @map("latest_table_hashes_json")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  latestSnapshot SyncSnapshot? @relation("LatestSnapshot", fields: [latestSnapshotId], references: [id], onDelete: SetNull)

  @@map("sync_heads")
}

model SyncSnapshot {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  revision       Int
  payloadSha256  String   @map("payload_sha256")
  sourceDeviceId String?  @map("source_device_id")
  archiveJson    Json?    @map("archive_json")
  tableHashesJson Json?   @map("table_hashes_json")
  blobUrl        String?  @map("blob_url")
  sizeBytes      Int      @default(0) @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDevice    Device?    @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)
  latestForHeads  SyncHead[] @relation("LatestSnapshot")

  @@unique([userId, revision], map: "sync_snapshots_user_id_revision_key")
  @@index([userId, payloadSha256], map: "sync_snapshots_user_id_payload_sha256_idx")
  @@index([userId, createdAt], map: "sync_snapshots_user_id_created_at_idx")
  @@map("sync_snapshots")
}

model SyncEvent {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  deviceId   String?  @map("device_id")
  endpoint   String
  outcome    String
  requestId  String?  @map("request_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "sync_events_created_at_idx")
  @@index([userId, createdAt], map: "sync_events_user_id_created_at_idx")
  @@map("sync_events")
}

// ---------------------------------------------------------------------------
// Online sync sessions (migrated from JSON file store)
// ---------------------------------------------------------------------------

model SyncSession {
  id                     String   @id @default(cuid())
  userId                 String   @map("user_id")
  status                 String   @default("awaiting_peer") // SyncSessionStatus
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  expiresAt              DateTime @map("expires_at")
  masterDeviceId         String   @map("master_device_id")
  slaveDeviceId          String?  @map("slave_device_id")
  syncMode               String?  @map("sync_mode") // "full" | "delta"
  masterMarkerHash       String?  @map("master_marker_hash")
  slaveMarkerHash        String?  @map("slave_marker_hash")
  masterTableHashes      Json?    @map("master_table_hashes")
  slaveTableHashes       Json?    @map("slave_table_hashes")
  currentStep            Int      @default(0) @map("current_step")
  stepLog                Json     @default("[]") @map("step_log") // SyncStepLog[]
  storageSessionPath     String?  @map("storage_session_path")
  storageCredentials     Json?    @map("storage_credentials")
  storageCredentialsSentAt DateTime? @map("storage_credentials_sent_at")
  resultMarkerHash       String?  @map("result_marker_hash")
  completedAt            DateTime? @map("completed_at")
  errorMessage           String?  @map("error_message")
  keyScheme              String   @default("v1-groupid") @map("key_scheme")
  keySalt                String?  @map("key_salt")

  historyEntries SyncHistoryEntry[]

  @@index([userId, status], map: "sync_sessions_user_id_status_idx")
  @@index([status, expiresAt], map: "sync_sessions_status_expires_idx")
  @@map("sync_sessions")
}

model SyncHistoryEntry {
  id               String   @id @default(cuid())
  sessionId        String   @map("session_id")
  masterDeviceId   String   @map("master_device_id")
  slaveDeviceId    String?  @map("slave_device_id")
  syncMode         String?  @map("sync_mode")
  resultMarkerHash String?  @map("result_marker_hash")
  startedAt        DateTime @map("started_at")
  completedAt      DateTime @map("completed_at")
  durationMs       Int      @map("duration_ms")
  status           String   // "completed" | "failed"
  errorMessage     String?  @map("error_message")
  stepCount        Int      @map("step_count")

  session SyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "sync_history_session_id_idx")
  @@index([completedAt], map: "sync_history_completed_at_idx")
  @@map("sync_history_entries")
}

model AsyncDeltaPackage {
  id                 String   @id @default(cuid())
  groupId            String   @map("group_id")
  fromDeviceId       String   @map("from_device_id")
  toGroupDevices     Boolean  @default(true) @map("to_group_devices")
  baseMarkerHash     String?  @map("base_marker_hash")
  newMarkerHash      String   @map("new_marker_hash")
  storagePath        String   @map("storage_path")
  storageBackendId   String?  @map("storage_backend_id")
  status             String   @default("pending") // AsyncPackageStatus
  fileSizeBytes      Int      @map("file_size_bytes")
  createdAt          DateTime @default(now()) @map("created_at")
  expiresAt          DateTime @map("expires_at")
  deliveredAt        DateTime? @map("delivered_at")
  deliveredToDeviceId String? @map("delivered_to_device_id")
  keyScheme          String   @default("v1-groupid") @map("key_scheme")
  keySalt            String?  @map("key_salt")

  @@index([groupId, status], map: "async_packages_group_status_idx")
  @@index([status, expiresAt], map: "async_packages_status_expires_idx")
  @@map("async_delta_packages")
}

model AsyncDeltaDelivery {
  id         String   @id @default(cuid())
  packageId  String   @map("package_id")
  deviceId   String   @map("device_id")
  ackedAt    DateTime @default(now()) @map("acked_at")

  @@unique([packageId, deviceId], map: "async_delivery_pkg_device_uq")
  @@index([packageId], map: "async_delivery_pkg_idx")
  @@map("async_delta_deliveries")
}

// ---------------------------------------------------------------------------
// Licensing (migrated from data/license-store.json)
// Cross-references (groupId/licenseId) are loose string IDs — referential
// integrity is enforced in license-store.ts, mirroring the prior JSON store.
// ---------------------------------------------------------------------------

model License {
  id         String    @id
  licenseKey String    @unique @map("license_key")
  groupId    String    @map("group_id")
  plan       String
  status     String
  maxDevices Int       @map("max_devices")
  createdAt  DateTime  @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@index([groupId], map: "licenses_group_id_idx")
  @@map("licenses")
}

model Group {
  id                    String  @id
  name                  String
  ownerId               String  @map("owner_id")
  licenseId             String  @map("license_id")
  storageBackendId      String  @map("storage_backend_id")
  fixedMasterDeviceId   String? @map("fixed_master_device_id")
  syncPriority          Json    @default("{}") @map("sync_priority")
  maxSyncFrequencyHours Float?  @map("max_sync_frequency_hours")
  maxDatabaseSizeMb     Int?    @map("max_database_size_mb")
  // Opcja C (bring-your-own-storage): kredencjały storage zaszyfrowane po stronie
  // KLIENTA. Serwer przechowuje wyłącznie szyfrogram i nie zna hasła storage.
  clientEncryptedStorageConfig Json? @map("client_encrypted_storage_config")

  @@index([ownerId], map: "client_groups_owner_id_idx")
  @@index([licenseId], map: "client_groups_license_id_idx")
  @@map("client_groups")
}

model LicenseDevice {
  deviceId       String    @id @map("device_id")
  groupId        String    @map("group_id")
  licenseId      String    @map("license_id")
  deviceName     String    @map("device_name")
  apiToken       String    @unique @map("api_token")
  registeredAt   DateTime  @map("registered_at")
  lastSeenAt     DateTime  @map("last_seen_at")
  lastSyncAt     DateTime? @map("last_sync_at")
  lastMarkerHash String?   @map("last_marker_hash")
  isFixedMaster  Boolean   @default(false) @map("is_fixed_master")

  @@index([licenseId], map: "license_devices_license_id_idx")
  @@index([groupId], map: "license_devices_group_id_idx")
  @@map("license_devices")
}

model StorageBackend {
  id                String   @id
  type              String
  name              String
  basePath          String   @map("base_path")
  maxFileSizeMb     Int      @map("max_file_size_mb")
  sessionTtlMinutes Int      @map("session_ttl_minutes")
  createdAt         DateTime @map("created_at")
  // Type-specific fields (host/port/username/password/secure/region/bucket/...).
  config            Json

  @@map("storage_backends")
}

// ---------------------------------------------------------------------------
// Direct-sync history (migrated from data/online-sync/_history.json).
// userId is a loose string (env-token or license device user) — no FK.
// ---------------------------------------------------------------------------

model DirectSyncHistory {
  id         String   @id
  userId     String   @map("user_id")
  deviceId   String   @map("device_id")
  action     String
  revision   Int
  hash       String?
  sizeBytes  Int?     @map("size_bytes")
  durationMs Int?     @map("duration_ms")
  status     String
  detail     String
  timestamp  DateTime

  @@index([timestamp], map: "direct_sync_history_timestamp_idx")
  @@map("direct_sync_history")
}

// ---------------------------------------------------------------------------
// Feedback reports (migrated from data/feedback/*). Attachments stored inline
// as base64 in `attachments` JSON; large files are dropped to metadata only.
// ---------------------------------------------------------------------------

model Feedback {
  id          String   @id
  subject     String?
  message     String?
  version     String?
  attachments Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "feedback_created_at_idx")
  @@map("feedback")
}

