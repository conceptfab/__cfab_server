generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  publicUserId String?       @unique @map("public_user_id")
  email        String?       @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  devices       Device[]
  syncHead      SyncHead?
  syncSnapshots SyncSnapshot[]
  syncEvents    SyncEvent[]

  @@map("users")
}

model Device {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  deviceId           String    @map("device_id")
  displayName        String?   @map("display_name")
  lastSeenAt         DateTime? @map("last_seen_at")
  lastClientRevision Int?      @map("last_client_revision")
  lastClientHash     String?   @map("last_client_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSnapshots SyncSnapshot[]

  @@unique([userId, deviceId], map: "devices_user_id_device_id_key")
  @@index([userId], map: "devices_user_id_idx")
  @@map("devices")
}

model SyncHead {
  userId               String   @id @map("user_id")
  latestRevision       Int      @default(0) @map("latest_revision")
  latestSnapshotId     String?  @map("latest_snapshot_id")
  latestPayloadSha256  String?  @map("latest_payload_sha256")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  latestSnapshot SyncSnapshot? @relation("LatestSnapshot", fields: [latestSnapshotId], references: [id], onDelete: SetNull)

  @@map("sync_heads")
}

model SyncSnapshot {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  revision       Int
  payloadSha256  String   @map("payload_sha256")
  sourceDeviceId String?  @map("source_device_id")
  archiveJson    Json?    @map("archive_json")
  tableHashesJson Json?   @map("table_hashes_json")
  blobUrl        String?  @map("blob_url")
  sizeBytes      Int      @default(0) @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDevice    Device?    @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)
  latestForHeads  SyncHead[] @relation("LatestSnapshot")

  @@unique([userId, revision], map: "sync_snapshots_user_id_revision_key")
  @@index([userId, payloadSha256], map: "sync_snapshots_user_id_payload_sha256_idx")
  @@index([userId, createdAt], map: "sync_snapshots_user_id_created_at_idx")
  @@map("sync_snapshots")
}

model SyncEvent {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  deviceId   String?  @map("device_id")
  endpoint   String
  outcome    String
  requestId  String?  @map("request_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "sync_events_created_at_idx")
  @@index([userId, createdAt], map: "sync_events_user_id_created_at_idx")
  @@map("sync_events")
}

// ---------------------------------------------------------------------------
// Online sync sessions (migrated from JSON file store)
// ---------------------------------------------------------------------------

model SyncSession {
  id                     String   @id @default(cuid())
  userId                 String   @map("user_id")
  status                 String   @default("awaiting_peer") // SyncSessionStatus
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  expiresAt              DateTime @map("expires_at")
  masterDeviceId         String   @map("master_device_id")
  slaveDeviceId          String?  @map("slave_device_id")
  syncMode               String?  @map("sync_mode") // "full" | "delta"
  masterMarkerHash       String?  @map("master_marker_hash")
  slaveMarkerHash        String?  @map("slave_marker_hash")
  masterTableHashes      Json?    @map("master_table_hashes")
  slaveTableHashes       Json?    @map("slave_table_hashes")
  currentStep            Int      @default(0) @map("current_step")
  stepLog                Json     @default("[]") @map("step_log") // SyncStepLog[]
  storageSessionPath     String?  @map("storage_session_path")
  storageCredentials     Json?    @map("storage_credentials")
  storageCredentialsSentAt DateTime? @map("storage_credentials_sent_at")
  resultMarkerHash       String?  @map("result_marker_hash")
  completedAt            DateTime? @map("completed_at")
  errorMessage           String?  @map("error_message")

  historyEntries SyncHistoryEntry[]

  @@index([userId, status], map: "sync_sessions_user_id_status_idx")
  @@index([status, expiresAt], map: "sync_sessions_status_expires_idx")
  @@map("sync_sessions")
}

model SyncHistoryEntry {
  id               String   @id @default(cuid())
  sessionId        String   @map("session_id")
  masterDeviceId   String   @map("master_device_id")
  slaveDeviceId    String?  @map("slave_device_id")
  syncMode         String?  @map("sync_mode")
  resultMarkerHash String?  @map("result_marker_hash")
  startedAt        DateTime @map("started_at")
  completedAt      DateTime @map("completed_at")
  durationMs       Int      @map("duration_ms")
  status           String   // "completed" | "failed"
  errorMessage     String?  @map("error_message")
  stepCount        Int      @map("step_count")

  session SyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "sync_history_session_id_idx")
  @@index([completedAt], map: "sync_history_completed_at_idx")
  @@map("sync_history_entries")
}

model AsyncDeltaPackage {
  id                 String   @id @default(cuid())
  groupId            String   @map("group_id")
  fromDeviceId       String   @map("from_device_id")
  toGroupDevices     Boolean  @default(true) @map("to_group_devices")
  baseMarkerHash     String?  @map("base_marker_hash")
  newMarkerHash      String   @map("new_marker_hash")
  storagePath        String   @map("storage_path")
  storageBackendId   String?  @map("storage_backend_id")
  status             String   @default("pending") // AsyncPackageStatus
  fileSizeBytes      Int      @map("file_size_bytes")
  createdAt          DateTime @default(now()) @map("created_at")
  expiresAt          DateTime @map("expires_at")
  deliveredAt        DateTime? @map("delivered_at")
  deliveredToDeviceId String? @map("delivered_to_device_id")

  @@index([groupId, status], map: "async_packages_group_status_idx")
  @@index([status, expiresAt], map: "async_packages_status_expires_idx")
  @@map("async_delta_packages")
}

